generator client {
    provider        = "prisma-client"
    previewFeatures = ["queryCompiler", "driverAdapters"]
    output          = "../src/generated/prisma"
    moduleFormat    = "esm"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
    id       Int    @id
    username String
    email    String /// @encrypted
}
